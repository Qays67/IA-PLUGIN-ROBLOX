		value = string.gsub(value, "/+$", "")
		state.url = value
		urlBox.Text = value
		saveSettings()
	end)

	label(config, {
		Text = "CODE D'APPAIRAGE",
		TextSize = 9.5,
		Font = Enum.Font.GothamBold,
		TextColor3 = C.faint,
