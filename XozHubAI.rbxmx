	corner(urlBox, 8)
	stroke(urlBox, C.line, 1, 0.4)
	padding(urlBox, 0, 10, 0, 10)
	ui.urlBox = urlBox

	urlBox.FocusLost:Connect(function()
		local value = trim(urlBox.Text)
		if value == "" then
