	local urlBox = new("TextBox", {
		Name = "UrlBox",
		Text = state.url,
		PlaceholderText = DEFAULT_URL,
		ClearTextOnFocus = false,
		Font = Enum.Font.Code,
		TextSize = 12,
		TextColor3 = C.text,
		BackgroundColor3 = C.field,
		Size = UDim2.new(1, -24, 0, 28),
		Position = UDim2.new(0, 12, 0, 26),
		BorderSizePixel = 0,
		TextXAlignment = Enum.TextXAlignment.Left,
